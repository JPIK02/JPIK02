# Préprod (projet Firebase séparé, données fictives) : build avec « vite build --mode preprod » (npm run build:preprod).
# Configuration publique de l'app web du projet préprod (console Firebase > Paramètres du projet > Vos applications) :
# à remplir quand le projet préprod existe. Ces valeurs ne sont pas secrètes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=0
VITE_ENV=preprod
